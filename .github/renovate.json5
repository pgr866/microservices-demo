{
  extends: [
    'github>GoogleCloudPlatform/kubernetes-engine-samples//.github/renovate-configs/dee-platform-ops.json5',
    'schedule:earlyMondays',
  ],
  'pip-compile': {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)requirements\\.txt$/',
    ],
  },
  pip_requirements: {
    enabled: false,
  },
  constraints: {
    python: '3.14.7',
  },
  kubernetes: {
    managerFilePatterns: [
      '/\\.yaml$/',
    ],
    ignorePaths: [
      // Upstream manifests that still use Google's images.
      'kustomize/base/**',
    ],
  },
}
