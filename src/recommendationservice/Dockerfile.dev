# One stage per README command, plus dev (hot reload).

FROM python:3.15.2-alpine3.24@sha256:0f9552bb28711333da16915ec146f5e6bb44a7fdac9ced15dc17c2e0206346dd AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_ROOT_USER_ACTION=ignore PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apk upgrade --no-cache
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.13.9-python3.15-alpine@sha256:61d5053f323bbdb706e3f02398aa7931d514ba1ef9bcf87c512d4549e98d8c1b /usr/local/bin/uv /usr/local/bin/
COPY requirements.txt requirements-test.in ./
RUN --mount=type=cache,target=/root/.cache/pip,id=pip \
    pip install --require-hashes --only-binary=:all: -r requirements.txt \
    && pip install grpcio-tools==1.85.3 -r requirements-test.in

FROM base AS source
COPY . .

FROM source AS test-run
RUN pytest --junitxml=reports/junit.xml
FROM scratch AS test
COPY --from=test-run /app/reports/ /reports/

FROM source AS coverage-run
RUN pytest --cov --cov-report=term --cov-report=xml:reports/coverage.xml
FROM scratch AS coverage
COPY --from=coverage-run /app/reports/ /reports/

FROM source AS lint
RUN ruff check .

FROM source AS format-run
RUN ruff format . && mkdir /out \
    && find . -maxdepth 1 -name '*.py' -not -name 'demo_pb2*' | xargs -I{} cp {} /out
FROM scratch AS format
COPY --from=format-run /out/ /

FROM source AS format-check
RUN ruff format --check .

FROM source AS dependencies-run
RUN uv pip compile --upgrade --generate-hashes requirements.in -o requirements.txt
FROM scratch AS dependencies
COPY --from=dependencies-run /app/requirements.txt /

FROM base AS codegen-run
WORKDIR /repo/src/app
COPY --from=protos . /repo/protos
COPY . .
RUN sh genproto.sh
FROM scratch AS codegen
COPY --from=codegen-run /repo/src/app/demo_pb2.py /repo/src/app/demo_pb2_grpc.py /

# gcompat: the devcontainer mounts the host's docker CLI, which is linked against glibc.
FROM base AS dev
COPY --from=fullstorydev/grpcurl:v1.9.3-alpine@sha256:4614424ed58e9b9837c48b6b8eadb9ef40491d5af3499bcc8b378e9c64a9e4a9 /bin/grpcurl /usr/local/bin/
RUN --mount=type=cache,target=/root/.cache/pip,id=pip \
    pip install watchdog==7.1.1
RUN apk add --no-cache git bash gcompat && adduser -D -u 1000 dev
USER dev
# compose.yaml checks health.
HEALTHCHECK NONE
ENTRYPOINT ["watchmedo", "auto-restart", "--directory=.", "--pattern=*.py", "--recursive", "--", "python", "recommendation_server.py"]
