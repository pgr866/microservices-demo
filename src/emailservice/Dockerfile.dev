# Local development only. Watches .py files and restarts on change.
FROM python:3.14.7-alpine
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /email_server
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt watchdog==6.0.0
ENTRYPOINT ["watchmedo", "auto-restart", "--directory=.", "--pattern=*.py", "--recursive", "--", "python", "email_server.py"]
