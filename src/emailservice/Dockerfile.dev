# Local development (the last stage, the default one) and one stage per tooling command of the README.

FROM python:3.14.8-alpine AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_ROOT_USER_ACTION=ignore PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

FROM base AS source
COPY requirements-test.in .
RUN pip install -r requirements-test.in
COPY . .

FROM source AS test-run
RUN pytest --junitxml=reports/junit.xml
FROM scratch AS test
COPY --from=test-run /app/reports/ /reports/

FROM source AS coverage-run
RUN pytest --cov=email_server --cov=logger --cov-report=term --cov-report=xml:reports/coverage.xml
FROM scratch AS coverage
COPY --from=coverage-run /app/reports/ /reports/

FROM source AS lint
RUN ruff check . --exclude demo_pb2.py,demo_pb2_grpc.py

FROM source AS format-run
RUN ruff format . --exclude demo_pb2.py,demo_pb2_grpc.py && mkdir /out \
    && find . -maxdepth 1 -name '*.py' -not -name 'demo_pb2*' | xargs -I{} cp {} /out
FROM scratch AS format
COPY --from=format-run /out/ /

FROM source AS format-check
RUN ruff format --check . --exclude demo_pb2.py,demo_pb2_grpc.py

FROM ghcr.io/astral-sh/uv:0.12.23-python3.14-alpine AS dependencies-run
WORKDIR /app
COPY requirements.in requirements.txt ./
RUN uv pip compile --upgrade requirements.in -o requirements.txt
FROM scratch AS dependencies
COPY --from=dependencies-run /app/requirements.txt /

FROM base AS codegen-run
WORKDIR /repo/src/app
COPY --from=protos . /repo/protos
COPY . .
RUN pip install grpcio-tools==1.84.0 \
    && cp demo_pb2.py demo_pb2_grpc.py /tmp/ && sh genproto.sh \
    && for f in demo_pb2.py demo_pb2_grpc.py; do \
        n=$(grep -n -m1 -x -F "$(head -n 1 $f)" /tmp/$f | cut -d: -f1); \
        { head -n $(( ${n:-1} - 1 )) /tmp/$f; cat $f; } > /tmp/new && mv /tmp/new $f; \
    done
FROM scratch AS codegen
COPY --from=codegen-run /repo/src/app/demo_pb2.py /repo/src/app/demo_pb2_grpc.py /

FROM base AS dev
RUN pip install watchdog==6.0.0
ENTRYPOINT ["watchmedo", "auto-restart", "--directory=.", "--pattern=*.py", "--recursive", "--", "python", "email_server.py"]
