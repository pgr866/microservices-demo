{
  "name": "grpc-currency-service",
  "version": "0.1.0",
  "description": "A gRPC currency conversion microservice",
  "repository": "https://github.com/GoogleCloudPlatform/microservices-demo",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint ."
  },
  "license": "Apache-2.0",
  "jest": {
    "reporters": [
      "default",
      ["jest-junit", { "outputDirectory": "reports", "outputName": "junit.xml" }]
    ],
    "collectCoverageFrom": [
      "*.js",
      "!*.test.js",
      "!eslint.config.js"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.14"
  }
}
