{
  "name": "paymentservice",
  "version": "0.0.1",
  "private": true,
  "description": "Payment Microservice demo",
  "repository": "https://github.com/GoogleCloudPlatform/microservices-demo",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"*.js\""
  },
  "author": "Jonathan Lui",
  "license": "Apache-2.0",
  "jest": {
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ]
    ],
    "collectCoverageFrom": [
      "*.js",
      "!*.test.js",
      "!eslint.config.js"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "pino": "10.4.0",
    "simple-card-validator": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "protobufjs": false,
    "unrs-resolver": false
  }
}
